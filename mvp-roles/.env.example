# Copie para .env.local (dev) e configure as mesmas variáveis na Vercel (Project Settings → Environment Variables).
# NUNCA commite .env.local. Variáveis com prefixo NEXT_PUBLIC_ vão para o navegador: não coloque segredo nelas.

# --- App -------------------------------------------------------------------
# URL pública do site (usada em links do convite, Open Graph e redirects de login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nome do app e do mascote (substituem [NOME_DO_APP] e [NOME_DO_MASCOTE] nos textos)
NEXT_PUBLIC_APP_NAME=NomeDoApp
NEXT_PUBLIC_MASCOTE_NOME=NomeDoMascote

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# "Publishable key" (equivale à antiga "anon key"). Pública por design; a segurança vem da RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (equivale à antiga "service_role"). SOMENTE servidor. Usada só para excluir conta e para o seed.
SUPABASE_SECRET_KEY=

# --- Check-in -----------------------------------------------------------------
# Segredo do HMAC dos QR de entrada. Gere com: openssl rand -base64 32
# Trocar este valor invalida TODOS os QR já emitidos.
CHECKIN_TOKEN_SECRET=

# --- Pagamentos ----------------------------------------------------------------
# Fase A: "pix_estatico" (único valor suportado no MVP)
PAYMENT_PROVIDER=pix_estatico
# TODO(fase-b): credenciais do PSP (não usar no MVP)
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=

# --- Só para o Supabase CLI / CI (não são lidas pelo app) ----------------------
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
# SUPABASE_ACCESS_TOKEN=
